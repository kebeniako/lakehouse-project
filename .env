# ============================================================
# MINIO - Stockage objet S3-compatible
# ============================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000

# ============================================================
# POSTGRESQL - Base de métadonnées (une instance, deux bases)
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Bases applicatives créées au démarrage via un script d'init SQL
AIRFLOW_DB=airflow_db
NESSIE_DB=nessie_db

# ============================================================
# NESSIE - Catalogue Iceberg
# ============================================================
NESSIE_URI=http://nessie:19120/api/v2
NESSIE_PORT=19120
# Connexion de Nessie à PostgreSQL (base nessie_db)
NESSIE_VERSION_STORE_TYPE=JDBC
NESSIE_JDBC_URL=jdbc:postgresql://postgres:5432/nessie_db
NESSIE_JDBC_USER=postgres
NESSIE_JDBC_PASSWORD=postgres

# ============================================================
# SPARK - Traitement
# ============================================================
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# ============================================================
# DREMIO - Moteur SQL
# ============================================================
DREMIO_UI_PORT=9047
DREMIO_COORD_PORT=31010

# ============================================================
# AIRFLOW - Orchestration
# ============================================================
AIRFLOW_UID=50000
AIRFLOW__WEBSERVER__RBAC=True
AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8082
# Connexion d'Airflow à PostgreSQL (base airflow_db)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/airflow_db
AIRFLOW__CORE__EXECUTOR=LocalExecutor
# Utilisateur admin créé par airflow-init
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ============================================================
# NIFI - Ingestion
# Port HTTP décalé pour éviter le conflit avec Spark Master UI (8080)
# ============================================================
NIFI_WEB_HTTP_PORT=8880
NIFI_WEB_HTTPS_PORT=8443
NIFI_SENSITIVE_PROPS_KEY=nifi_sensitive_props_key_2024